# Database
DATABASE_URL=mongodb://localhost:27017/relun_db
# Or for MongoDB Atlas:
# DATABASE_URL=mongodb+srv://username:password@cluster.mongodb.net/relun_db?retryWrites=true&w=majority

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Email Service (SendGrid)
SENDGRID_API_KEY=your-sendgrid-api-key
FROM_EMAIL=noreply@relun.app

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Gmail SMTP
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=your-gmail@gmail.com

# Termii (SMS & Email Fallback)
TERMII_API_KEY=your-termii-api-key
TERMII_SENDER_ID=N-Alert
TERMII_EMAIL_CONFIG_ID=your-termii-email-config-id
TERMII_EMAIL_FROM=noreply@relun.app

# OAuth
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
APPLE_CLIENT_ID=your-apple-client-id
APPLE_TEAM_ID=your-apple-team-id
APPLE_KEY_ID=your-apple-key-id
APPLE_PRIVATE_KEY_PATH=path-to-apple-private-key

# Redis (for caching and real-time features)
REDIS_URL=redis://localhost:6379/0

# File Upload
MAX_UPLOAD_SIZE=5242880
UPLOAD_DIR=uploads

# App Settings
APP_NAME=Relun
APP_VERSION=1.0.0
DEBUG=True

# Native Android app
# Firebase service-account JSON (Firebase console > Project settings > Service accounts), for FCM pushes
FIREBASE_SERVICE_ACCOUNT_PATH=./secrets/firebase-service-account.json
# Google Play purchase verification (Play Console > API access > service account with Financial data access)
ANDROID_PACKAGE_NAME=com.relun.app
GOOGLE_PLAY_SERVICE_ACCOUNT_PATH=./secrets/play-service-account.json

# Coins
# Set to false to let any match chat for free (keeps the old Expo app working)
ENFORCE_CHAT_UNLOCK=true
# Coins given to new accounts
SIGNUP_BONUS_COINS=500

# Web coin purchases (Paystack). Webhook URL: https://<api>/api/coins/paystack/webhook
PAYSTACK_SECRET_KEY=sk_test_xxx
PAYSTACK_CURRENCY=NGN
# Optional per-package prices in minor units (kobo), e.g. 750000 = NGN 7,500
# PAYSTACK_PRICE_COINS_100=750000
# PAYSTACK_PRICE_COINS_500=3000000
# PAYSTACK_PRICE_COINS_1000=5200000
# PAYSTACK_PRICE_COINS_5000=15000000
